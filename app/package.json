{
  "name": "memex-desktop",
  "version": "0.1.0",
  "description": "Desktop app for Memex — install, set up, and drive your second brain with a chat + dashboards UI on top of the Claude agent.",
  "author": "Memex",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && cp src/renderer/index.html src/renderer/styles.css dist/renderer/",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "start": "npm run build && electron .",
    "dev": "npm run build && MEMEX_DEV=1 electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.211",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.1.1",
    "typescript": "^7.0.2"
  }
}
